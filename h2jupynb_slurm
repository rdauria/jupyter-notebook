def gethostname(line):
    """
    Check a line from the remote output and extract the hostname.
    Returns True if hostname was found, False otherwise.
    """
    global hostname, jobid
    line = line.strip()
    # skip the terminal's echo of the srun command line ($(hostname), `hostname`)
    if line.startswith('HOSTNAME') and ('$' not in line) and ('`' not in line):
        # line format: HOSTNAME=<host> SLURM_JOB_ID=<id>
        fields = dict(f.partition('=')[::2] for f in line.split())
        hostname = fields.get('HOSTNAME', '').strip()
        jobid = fields.get('SLURM_JOB_ID', '').strip()
        return True
    return False

